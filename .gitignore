# Data and databases
agenthub/agents/youtube/db

# Camera masters kept by scripts/optimize-images.mjs and scripts/compress-videos.mjs
# before they rewrite in place. Local safety net only — these are the full-weight
# originals and must never be committed.
/_originals/

# Mirrored out of src/assets/Portfolio/Videography by scripts/sync-videos.mjs,
# which runs as part of the build. Committing it would store every clip twice.
/public/videos/portfolio/

